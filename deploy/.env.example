# Synthetic-data preview only. Copy this file to .env and replace the secret.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AAROGYA_SESSION_SECRET=

# For local-only preview, keep localhost and the loopback bind address.
# For a public synthetic-data demo, set DOMAIN to a DNS name pointing to the
# host and BIND_ADDRESS=0.0.0.0; allow inbound TCP 80/443 and UDP 443.
DOMAIN=localhost
BIND_ADDRESS=127.0.0.1
